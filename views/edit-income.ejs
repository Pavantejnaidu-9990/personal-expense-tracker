<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Income - Expense Tracker</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="dashboard-container">

    <!-- Sidebar -->
    <aside class="sidebar">

        <div class="logo">
            <i class="bi bi-wallet2"></i>
            <span>Expense Tracker</span>
        </div>

        <nav class="sidebar-nav">

            <a href="/" class="nav-link">
                <i class="bi bi-grid"></i>
                <span>Dashboard</span>
            </a>

            <a href="/expenses" class="nav-link">
                <i class="bi bi-arrow-down-circle"></i>
                <span>Expenses</span>
            </a>

            <a href="/income" class="nav-link active">
                <i class="bi bi-arrow-up-circle"></i>
                <span>Income</span>
            </a>

            <a href="/reports" class="nav-link">
                <i class="bi bi-bar-chart"></i>
                <span>Reports</span>
            </a>
            <a href="/budget" class="nav-link">
                <i class="bi bi-wallet"></i>
                <span>Budget</span>
            </a>


            <a href="/settings" class="nav-link">
                <i class="bi bi-gear"></i>
                <span>Settings</span>
            </a>

            <a href="/logout" class="nav-link">
                <i class="bi bi-box-arrow-right"></i>
                <span>Logout</span>
            </a>

        </nav>

    </aside>

    <!-- Main Content -->
    <main class="main-content">

        <header class="top-header">

            <div>
                <h1>Edit Income ✏️</h1>
                <p>Update your income details</p>
            </div>

        </header>

        <div class="form-card">

            <h2>Income Details</h2>

            <form action="/edit-income/<%= income._id %>" method="POST">

                <div class="input-group">

                    <label for="title">Income Source</label>

                    <input
                        type="text"
                        id="title"
                        name="title"
                        value="<%= income.title %>"
                        placeholder="e.g. Salary"
                        required
                    >

                </div>


                <div class="input-group">

                    <label for="amount">Amount</label>

                    <input
                        type="number"
                        id="amount"
                        name="amount"
                        value="<%= income.amount %>"
                        placeholder="Enter amount"
                        min="0"
                        required
                    >

                </div>


                <div class="input-group">

                    <label for="category">Category</label>

                    <select id="category" name="category" required>

                        <option value="Salary"
                            <%= income.category === "Salary" ? "selected" : "" %>>
                            Salary
                        </option>

                        <option value="Freelance"
                            <%= income.category === "Freelance" ? "selected" : "" %>>
                            Freelance
                        </option>

                        <option value="Business"
                            <%= income.category === "Business" ? "selected" : "" %>>
                            Business
                        </option>

                        <option value="Scholarship"
                            <%= income.category === "Scholarship" ? "selected" : "" %>>
                            Scholarship
                        </option>

                        <option value="Investment"
                            <%= income.category === "Investment" ? "selected" : "" %>>
                            Investment
                        </option>

                        <option value="Gift"
                            <%= income.category === "Gift" ? "selected" : "" %>>
                            Gift
                        </option>

                        <option value="Other"
                            <%= income.category === "Other" ? "selected" : "" %>>
                            Other
                        </option>

                    </select>

                </div>


                <div class="input-group">

                    <label for="date">Date</label>

                    <input
                        type="date"
                        id="date"
                        name="date"
                        value="<%= new Date(income.date).toISOString().split('T')[0] %>"
                        required
                    >

                </div>


                <button type="submit" class="create-btn">
                    <i class="bi bi-check-circle"></i>
                    Update Income
                </button>

                <a href="/income" class="cancel-btn">
                    Cancel
                </a>

            </form>

        </div>

    </main>

</div>

</body>
</html>